<?xml version="1.0" encoding="UTF-8"?>
<!-- 
	* web.xml
		- 배포서술자
		- 웹어플리케이션을 구동시킬 때 서버에 의해 가장 먼저 읽혀지는 파일
		- web.xml에는 Filter, Servlet, Wrapper등(서버 설정과 관련된 객체) 다양한 객체를 등록할 수 있다.
-->
<web-app xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://xmlns.jcp.org/xml/ns/javaee" xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd" id="WebApp_ID" version="4.0">

  <display-name>01_HelloWeb</display-name>
  <!--
  	* welcome-file-list
  		- 처름 url로 현재 어플리케이션의 루트로 요청시 먼저 보여줄 파일
  		- webapp 바로 아래에 존재하여야 한다.
  -->
  <welcome-file-list>
    <welcome-file>index.html</welcome-file>
    <welcome-file>index.jsp</welcome-file>
    <welcome-file>index.htm</welcome-file>
    <welcome-file>default.html</welcome-file>
    <welcome-file>default.jsp</welcome-file>
    <welcome-file>default.htm</welcome-file>
  </welcome-file-list>
  
  <!-- 
  	생성한 서블릿 등록
  		1. web.xml 등록
  		2. annotation 자동 등록
  -->
  <servlet>
  	<servlet-name>firstServlet</servlet-name>
  	<servlet-class>com.kh.basic.BasicServlet</servlet-class>
  </servlet>
  
  <servlet-mapping>
  	<servlet-name>firstServlet</servlet-name>
  	<url-pattern>/first</url-pattern>
  </servlet-mapping>
  
</web-app>